<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dune 3000 - Algorithmic RTS</title>
  <style>
    * { box-sizing: border-box; }
    body {
      background: #0b0c10;
      color: #cbd5e1;
      font-family: 'Consolas', 'Menlo', 'Monaco', monospace;
      margin: 0;
      padding: 16px 24px;
      width: 100%;
    }
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
      border-bottom: 1px solid #334155;
      padding-bottom: 8px;
    }
    h2 {
      margin: 0;
      color: #f59e0b;
      letter-spacing: 1px;
      font-size: 20px;
    }
    .badge {
      background: #1e293b;
      color: #94a3b8;
      font-size: 11px;
      padding: 3px 8px;
      border: 1px solid #475569;
      border-radius: 3px;
    }
    #hud {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
      background: #141720;
      border: 1px solid #2e384d;
      border-left: 4px solid #f59e0b;
      padding: 10px 16px;
      margin-bottom: 12px;
      font-size: 13px;
    }
    .hud-group {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .hud-label { color: #64748b; font-size: 11px; text-transform: uppercase; }
    .hud-stat { font-weight: bold; color: #38bdf8; }
    .hud-house-atr { color: #60a5fa; font-weight: bold; }
    .hud-house-har { color: #f87171; font-weight: bold; }
    #controls {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 14px;
      background: #141720;
      padding: 10px;
      border: 1px solid #2e384d;
    }
    button {
      background: #1e2433;
      color: #e2e8f0;
      border: 1px solid #3b4252;
      padding: 6px 10px;
      font-family: inherit;
      font-size: 11px;
      cursor: pointer;
      transition: all 0.15s ease;
      user-select: none;
    }
    button:hover {
      background: #2b3347;
      border-color: #60a5fa;
      color: #ffffff;
    }
    button.active {
      background: #1d4ed8;
      border-color: #93c5fd;
      color: #ffffff;
      box-shadow: 0 0 8px rgba(37, 99, 235, 0.5);
    }
    button.btn-special {
      border-color: #f59e0b;
      color: #fbbf24;
    }
    button.btn-special:hover {
      background: #78350f;
    }
    #main-area {
      display: flex;
      gap: 16px;
      align-items: flex-start;
      flex-wrap: wrap;
    }
    #canvas-container {
      position: relative;
      border: 2px solid #334155;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.6);
      background: #111;
      width: 672px;
      height: 672px;
      user-select: none;
    }
    canvas#gameCanvas {
      display: block;
      image-rendering: pixelated;
      cursor: crosshair;
    }
    #sidebar {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 320px;
    }
    .panel-box {
      background: #141720;
      border: 1px solid #2e384d;
      padding: 10px;
    }
    .panel-header {
      font-size: 11px;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
      padding-bottom: 4px;
      border-bottom: 1px solid #222938;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    #radar-canvas {
      display: block;
      margin: 0 auto;
      border: 1px solid #334155;
      background: #090d14;
    }
    #log-panel {
      height: 440px;
      background: #0a0c10;
      border: 1px solid #1e2433;
      padding: 8px 10px;
      overflow-y: auto;
      font-size: 11px;
      line-height: 1.5;
    }
    .log-entry {
      margin-bottom: 4px;
      border-bottom: 1px solid #161b26;
      padding-bottom: 2px;
      color: #94a3b8;
    }
    .log-entry.log-combat { color: #f87171; }
    .log-entry.log-economy { color: #fbbf24; }
    .log-entry.log-worm { color: #fb923c; font-weight: bold; }
    .log-entry.log-sys { color: #38bdf8; }
  </style>
</head>
<body>
  <header>
    <h2>Dune 3000: Arrakis Tactical Command</h2>
    <span class="badge">Dune 2000 Expansion: Squad Drag-Select, Undulating Worm & Full Arsenal v4.0</span>
  </header>

  <div id="hud">
    <div class="hud-group">
      <span class="hud-label">Conflict:</span>
      <span class="hud-house-atr">Atreides</span> vs <span class="hud-house-har">Harkonnen</span>
    </div>
    <div class="hud-group">
      <span class="hud-label">Credits:</span>
      <span id="hud-credits" class="hud-stat">1000</span> / <span id="hud-capacity">2000</span>
    </div>
    <div class="hud-group">
      <span class="hud-label">Power:</span>
      <span id="hud-power" class="hud-stat">100 / 30 (100%)</span>
    </div>
    <div class="hud-group">
      <span class="hud-label">Cycle:</span>
      <span id="hud-tick" class="hud-stat">0</span>
    </div>
    <div class="hud-group">
      <span class="hud-label">Condition:</span>
      <span id="hud-status" class="hud-stat" style="color:#22c55e">Battle Active</span>
    </div>
    <div class="hud-group">
      <span class="hud-label">Opponent:</span>
      <span id="hud-opponent" class="hud-stat">Script AI</span>
    </div>
  </div>

  <div id="controls">
    <button id="btn-select-mode" class="active" onclick="setMode('select')">Select / Marquee Box</button>
    <button id="btn-build-concrete" onclick="setMode('Concrete')">Concrete (50)</button>
    <button id="btn-build-windtrap" onclick="setMode('WindTrap')">WindTrap (200)</button>
    <button id="btn-build-refinery" onclick="setMode('Refinery')">Refinery (400)</button>
    <button id="btn-build-silo" onclick="setMode('Silo')">Silo (150)</button>
    <button id="btn-build-heavyfactory" onclick="setMode('HeavyFactory')">Heavy Factory (600)</button>
    <button id="btn-build-hightech" onclick="setMode('HighTech')">High-Tech (500)</button>
    <button id="btn-build-gunturret" onclick="setMode('GunTurret')">Gun Turret (250)</button>
    <button id="btn-build-repair" onclick="setMode('RepairFacility')">Repair Facility (350)</button>
    <button id="btn-build-palace" onclick="setMode('Palace')">Palace (800)</button>
    <button id="btn-train-harvester" onclick="trainUnit('Harvester', 400)">Train Harvester (400)</button>
    <button id="btn-train-trike" onclick="trainUnit('Trike', 150)">Train Trike (150)</button>
    <button id="btn-train-tank" onclick="trainUnit('CombatTank', 300)">Train Tank (300)</button>
    <button id="btn-step-tick" onclick="stepTick()">Step Tick</button>
    <button id="btn-autoplay" onclick="toggleAutoplay()">Auto-Play: ON</button>
    <button id="btn-gpu" class="btn-special" onclick="toggleGpuMode()" title="Opponent (Harkonnen) is commanded by local LLM on GPU; falls back to script AI if busy">Play against GPU: OFF</button>
    <button id="btn-sound" onclick="toggleSound()">Sound: ON</button>
  </div>

  <div id="main-area">
    <div id="canvas-container">
      <canvas id="gameCanvas" width="672" height="672"></canvas>
    </div>
    <div id="sidebar">
      <div class="panel-box">
        <div class="panel-header">
          <span>Tactical Radar (24x24)</span>
          <span id="radar-status" style="color:#22c55e">ONLINE</span>
        </div>
        <canvas id="radar-canvas" width="168" height="168"></canvas>
      </div>
      <div class="panel-box">
        <div class="panel-header">
          <span>Arrakis Command Log</span>
          <span style="font-size:10px; color:#64748b">Live Feeds</span>
        </div>
        <div id="log-panel"></div>
      </div>
    </div>
  </div>

  <script>
    /* =========================================================================
       AUDIO SYNTHESIS SYSTEM (Web Audio API)
       ========================================================================= */
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    let audioCtx = null;
    let soundEnabled = true;

    function initAudio() {
      if (!audioCtx && AudioContextClass) {
        audioCtx = new AudioContextClass();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function toggleSound() {
      soundEnabled = !soundEnabled;
      document.getElementById('btn-sound').textContent = 'Sound: ' + (soundEnabled ? 'ON' : 'OFF');
      if (soundEnabled) initAudio();
    }

    function playSound(type) {
      if (!soundEnabled) return;
      initAudio();
      if (!audioCtx) return;
      const now = audioCtx.currentTime;

      if (type === 'click') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(650, now);
        osc.frequency.exponentialRampToValueAtTime(300, now + 0.04);
        gain.gain.setValueAtTime(0.08, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.04);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(now); osc.stop(now + 0.04);
      } else if (type === 'cannon') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(140, now);
        osc.frequency.exponentialRampToValueAtTime(35, now + 0.18);
        gain.gain.setValueAtTime(0.25, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(now); osc.stop(now + 0.18);
      } else if (type === 'worm') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(50, now);
        osc.frequency.linearRampToValueAtTime(80, now + 0.3);
        osc.frequency.exponentialRampToValueAtTime(25, now + 0.6);
        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(now); osc.stop(now + 0.6);
      } else if (type === 'build') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(220, now);
        osc.frequency.setValueAtTime(330, now + 0.06);
        osc.frequency.setValueAtTime(440, now + 0.12);
        gain.gain.setValueAtTime(0.07, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(now); osc.stop(now + 0.22);
      } else if (type === 'harvest') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(300, now);
        osc.frequency.linearRampToValueAtTime(520, now + 0.15);
        gain.gain.setValueAtTime(0.06, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(now); osc.stop(now + 0.15);
      }
    }

    /* =========================================================================
       30-DEGREE QUANTIZATION & ROTATION (12 COMPASS SECTORS)
       ========================================================================= */
    const DEG30 = Math.PI / 6;

    function quantizeAngle30(rad) {
      let norm = rad % (Math.PI * 2);
      if (norm < 0) norm += Math.PI * 2;
      const sector = Math.round(norm / DEG30) % 12;
      return sector * DEG30;
    }

    function stepAngleTowards30(currentAngle, targetRad) {
      let normCur = currentAngle % (Math.PI * 2);
      if (normCur < 0) normCur += Math.PI * 2;
      const curSector = Math.round(normCur / DEG30) % 12;

      let normTgt = targetRad % (Math.PI * 2);
      if (normTgt < 0) normTgt += Math.PI * 2;
      const targetSector = Math.round(normTgt / DEG30) % 12;

      if (curSector === targetSector) return curSector * DEG30;

      const diff = (targetSector - curSector + 12) % 12;
      if (diff > 6) {
        return ((curSector - 1 + 12) % 12) * DEG30;
      } else {
        return ((curSector + 1) % 12) * DEG30;
      }
    }

    /* =========================================================================
       24x24 ARRAKIS MAP & BUILDING SPECIFICATIONS
       ========================================================================= */
    const TILE = 28, W = 24, H = 24;
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const radarCanvas = document.getElementById('radar-canvas');
    const radarCtx = radarCanvas.getContext('2d');

    const HOUSE_COLORS = {
      Atreides: { main: '#2563eb', dark: '#1d4ed8', light: '#60a5fa', glow: 'rgba(37,99,235,0.4)' },
      Harkonnen: { main: '#dc2626', dark: '#991b1b', light: '#f87171', glow: 'rgba(220,38,38,0.4)' },
      Ordos: { main: '#16a34a', dark: '#15803d', light: '#4ade80', glow: 'rgba(22,163,74,0.4)' }
    };

    const BUILDING_SPECS = {
      Concrete: { cost: 50, hp: 100, pProd: 0, pCons: 0 },
      WindTrap: { cost: 200, hp: 400, pProd: 100, pCons: 0 },
      Refinery: { cost: 400, hp: 450, pProd: 0, pCons: 30 },
      Silo: { cost: 150, hp: 350, pProd: 0, pCons: 10 },
      HeavyFactory: { cost: 600, hp: 500, pProd: 0, pCons: 40 },
      HighTech: { cost: 500, hp: 450, pProd: 0, pCons: 35 },
      GunTurret: { cost: 250, hp: 350, pProd: 0, pCons: 20, range: 4.5, dmg: 20 },
      RepairFacility: { cost: 350, hp: 400, pProd: 0, pCons: 30 },
      Palace: { cost: 800, hp: 700, pProd: 0, pCons: 50 }
    };

    let mode = 'select';
    let selectedUnits = [];
    let selectedUnit = null;
    let tickCount = 0;
    let credits = { Atreides: 1000, Harkonnen: 1000 };

    // Marquee Drag-Selection state
    let isDragging = false;
    let dragStart = { x: 0, y: 0 };
    let dragCurrent = { x: 0, y: 0 };

    // Diverse 24x24 Arrakis terrain
    let tiles = Array.from({ length: H }, (_, y) =>
      Array.from({ length: W }, (_, x) => {
        if (x <= 5 && y <= 5) {
          if ((x === 2 && y === 2) || (x === 2 && y === 3) || (x === 3 && y === 2)) return 'CONCRETE';
          return 'ROCK';
        }
        if (x >= 18 && y >= 18) {
          if ((x === 21 && y === 21) || (x === 21 && y === 20) || (x === 20 && y === 21)) return 'CONCRETE';
          return 'ROCK';
        }
        if ((x === 10 && y <= 7) || (x === 13 && y >= 16)) return 'MOUNTAIN';
        if (Math.hypot(x - 17, y - 5) < 2.2 || Math.hypot(x - 5, y - 18) < 2.2) return 'CRATER';
        if (Math.hypot(x - 15, y - 9) < 2.0 || Math.hypot(x - 8, y - 14) < 2.0) return 'ROCK';
        if (Math.hypot(x - 11.5, y - 11.5) < 2.6) return (x + y) % 2 === 0 ? 'SPICE_THICK' : 'SPICE_THIN';
        if (Math.hypot(x - 7.5, y - 8.5) < 1.8 || Math.hypot(x - 16.5, y - 14.5) < 1.8) return 'SPICE_THIN';
        if ((x * 3 + y * 5) % 11 === 0) return 'DUNES';
        return 'SAND';
      })
    );

    let buildings = [
      { type: 'ConstructionYard', house: 'Atreides', x: 2, y: 2, hp: 400, maxHp: 400, pProd: 50, pCons: 0 },
      { type: 'WindTrap', house: 'Atreides', x: 3, y: 2, hp: 400, maxHp: 400, pProd: 100, pCons: 0 },
      { type: 'Refinery', house: 'Atreides', x: 2, y: 3, hp: 400, maxHp: 400, pProd: 0, pCons: 30 },
      { type: 'GunTurret', house: 'Atreides', x: 4, y: 4, hp: 350, maxHp: 350, pProd: 0, pCons: 20, range: 4.5, dmg: 20 },
      { type: 'RepairFacility', house: 'Atreides', x: 1, y: 3, hp: 400, maxHp: 400, pProd: 0, pCons: 30 },
      { type: 'ConstructionYard', house: 'Harkonnen', x: 21, y: 21, hp: 400, maxHp: 400, pProd: 50, pCons: 0 },
      { type: 'WindTrap', house: 'Harkonnen', x: 21, y: 20, hp: 400, maxHp: 400, pProd: 100, pCons: 0 },
      { type: 'Refinery', house: 'Harkonnen', x: 20, y: 21, hp: 400, maxHp: 400, pProd: 0, pCons: 30 },
      { type: 'GunTurret', house: 'Harkonnen', x: 19, y: 19, hp: 350, maxHp: 350, pProd: 0, pCons: 20, range: 4.5, dmg: 20 }
    ];

    let units = [
      { type: 'Harvester', house: 'Atreides', x: 3.5, y: 4.5, tx: 7.5, ty: 8.5, hp: 120, maxHp: 120, spice: 0, maxSpice: 700, dmg: 5, range: 1.5, angle: 0, turretAngle: 0, speed: 1.1, turnTimer: 0, airlifted: false, wormPanic: false, retreatWarning: false, lastAttacker: null },
      { type: 'CombatTank', house: 'Atreides', x: 5.5, y: 3.5, tx: 8.5, ty: 6.5, hp: 140, maxHp: 140, spice: 0, maxSpice: 0, dmg: 25, range: 4.0, angle: 0, turretAngle: 0, speed: 1.6, turnTimer: 0, airlifted: false, wormPanic: false, retreatWarning: false, lastAttacker: null },
      { type: 'Trike', house: 'Atreides', x: 4.5, y: 5.5, tx: 9.5, ty: 9.5, hp: 90, maxHp: 90, spice: 0, maxSpice: 0, dmg: 15, range: 2.8, angle: 0, turretAngle: 0, speed: 2.6, turnTimer: 0, airlifted: false, wormPanic: false, retreatWarning: false, lastAttacker: null },
      { type: 'Harvester', house: 'Harkonnen', x: 19.5, y: 18.5, tx: 16.5, ty: 14.5, hp: 120, maxHp: 120, spice: 0, maxSpice: 700, dmg: 5, range: 1.5, angle: Math.PI, turretAngle: Math.PI, speed: 1.1, turnTimer: 0, airlifted: false, wormPanic: false, retreatWarning: false, lastAttacker: null },
      { type: 'CombatTank', house: 'Harkonnen', x: 18.5, y: 19.5, tx: 14.5, ty: 16.5, hp: 140, maxHp: 140, spice: 0, maxSpice: 0, dmg: 25, range: 4.0, angle: Math.PI, turretAngle: Math.PI, speed: 1.6, turnTimer: 0, airlifted: false, wormPanic: false, retreatWarning: false, lastAttacker: null },
      { type: 'Trike', house: 'Harkonnen', x: 17.5, y: 18.5, tx: 13.5, ty: 13.5, hp: 90, maxHp: 90, spice: 0, maxSpice: 0, dmg: 15, range: 2.8, angle: Math.PI, turretAngle: Math.PI, speed: 2.6, turnTimer: 0, airlifted: false, wormPanic: false, retreatWarning: false, lastAttacker: null }
    ];

    let carryalls = [
      { house: 'Atreides', x: 2.5, y: 2.5, tx: 2.5, ty: 2.5, speed: 4.2, angle: 0, carryingUnit: null, state: 'idle', wingPhase: 0 },
      { house: 'Harkonnen', x: 21.5, y: 21.5, tx: 21.5, ty: 21.5, speed: 4.2, angle: Math.PI, carryingUnit: null, state: 'idle', wingPhase: 0 }
    ];

    /* Shai-Hulud Sandworm with Sinusoidal Waving, Fatigue, Burrow Recovery & Boss Healthbar */
    let sandworm = {
      x: 11.5, y: 18.5,
      tx: 11.5, ty: 18.5,
      speed: 1.4,
      baseSpeed: 1.4,
      angle: 0,
      hp: 600,
      maxHp: 600,
      lastBurrowHp: 600, // Tracks 1/3 HP threshold (200 HP intervals)
      stamina: 100,      // Fatigue system
      dormant: false,
      dormantTimer: 0,
      submerged: false,
      submergeTimer: 0,
      wavePhase: 0,      // Sinusoidal undulating slither phase
      segments: [
        { x: 11.5, y: 18.5, waveOffset: 0 },
        { x: 11.5, y: 18.5, waveOffset: 0 },
        { x: 11.5, y: 18.5, waveOffset: 0 },
        { x: 11.5, y: 18.5, waveOffset: 0 }
      ]
    };

    /* =========================================================================
       PARTICLE & VISUAL EFFECTS SYSTEM
       ========================================================================= */
    const particles = [];

    function addExplosion(x, y) {
      playSound('cannon');
      for (let i = 0; i < 18; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 1.0 + Math.random() * 3.5;
        particles.push({
          type: 'spark',
          x: x * TILE,
          y: y * TILE,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          life: 25 + Math.floor(Math.random() * 20),
          maxLife: 45,
          color: Math.random() > 0.4 ? '#fbbf24' : '#ef4444',
          size: 2 + Math.random() * 3
        });
      }
      particles.push({
        type: 'shockwave',
        x: x * TILE,
        y: y * TILE,
        r: 4,
        maxR: 24,
        life: 14,
        maxLife: 14
      });
    }

    function addDust(x, y) {
      particles.push({
        type: 'dust',
        x: x * TILE + (Math.random() * 8 - 4),
        y: y * TILE + (Math.random() * 8 - 4),
        vx: (Math.random() - 0.5) * 0.4,
        vy: -0.3 - Math.random() * 0.4,
        life: 18,
        maxLife: 18,
        size: 3 + Math.random() * 3
      });
    }

    function addTracer(x1, y1, x2, y2) {
      particles.push({
        type: 'tracer',
        x1: x1 * TILE,
        y1: y1 * TILE,
        x2: x2 * TILE,
        y2: y2 * TILE,
        life: 6,
        maxLife: 6
      });
    }

    function addWaypoint(x, y) {
      particles.push({
        type: 'waypoint',
        x: x * TILE,
        y: y * TILE,
        r: 14,
        life: 22,
        maxLife: 22
      });
    }

    function updateParticles() {
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.life--;
        if (p.life <= 0) {
          particles.splice(i, 1);
          continue;
        }
        if (p.type === 'spark' || p.type === 'dust') {
          p.x += p.vx;
          p.y += p.vy;
        } else if (p.type === 'shockwave') {
          p.r += (p.maxR - p.r) * 0.2;
        } else if (p.type === 'waypoint') {
          p.r = Math.max(3, p.r * 0.94);
        }
      }
    }

    /* =========================================================================
       LOGGING SYSTEM
       ========================================================================= */
    function logMsg(msg, category = 'sys') {
      const panel = document.getElementById('log-panel');
      const div = document.createElement('div');
      div.className = `log-entry log-${category}`;
      div.textContent = `[${tickCount.toString().padStart(4, '0')}] ${msg}`;
      panel.prepend(div);
      while (panel.children.length > 70) {
        panel.removeChild(panel.lastChild);
      }
    }

    function setMode(m) {
      initAudio();
      playSound('click');
      mode = m;
      document.querySelectorAll('#controls button').forEach(b => b.classList.remove('active'));
      const mapBtn = {
        select: 'btn-select-mode', Concrete: 'btn-build-concrete',
        WindTrap: 'btn-build-windtrap', Refinery: 'btn-build-refinery', Silo: 'btn-build-silo',
        HeavyFactory: 'btn-build-heavyfactory', HighTech: 'btn-build-hightech',
        GunTurret: 'btn-build-gunturret', RepairFacility: 'btn-build-repair', Palace: 'btn-build-palace'
      };
      if (mapBtn[m]) document.getElementById(mapBtn[m]).classList.add('active');
    }

    function maxCapacity(house) {
      let cap = 1000;
      for (const b of buildings) {
        if (b.house === house && b.hp > 0 && (b.type === 'Refinery' || b.type === 'Silo')) cap += 1000;
      }
      return cap;
    }

    function trainUnit(unitType, cost) {
      initAudio();
      if (credits.Atreides < cost) {
        logMsg(`Insufficient credits for ${unitType} (${cost}).`, 'economy');
        return;
      }
      credits.Atreides -= cost;
      playSound('build');
      const isTank = unitType === 'CombatTank';
      const isTrike = unitType === 'Trike';
      const u = {
        type: unitType, house: 'Atreides', x: 3.5, y: 4.5, tx: 6.5, ty: 6.5,
        hp: isTank ? 140 : (isTrike ? 90 : 120),
        maxHp: isTank ? 140 : (isTrike ? 90 : 120),
        spice: 0, maxSpice: unitType === 'Harvester' ? 700 : 0,
        dmg: isTank ? 25 : (isTrike ? 15 : 5),
        range: isTank ? 4.0 : (isTrike ? 2.8 : 1.5),
        angle: 0,
        turretAngle: 0,
        speed: isTrike ? 2.6 : (isTank ? 1.6 : 1.1),
        turnTimer: 0,
        airlifted: false,
        wormPanic: false,
        retreatWarning: false,
        lastAttacker: null
      };
      units.push(u);
      selectedUnits = [u];
      selectedUnit = u;
      logMsg(`Trained Atreides ${unitType} at base.`, 'economy');
    }

    /* =========================================================================
       MOUSE DRAG MARQUEE SQUAD SELECTION & COMMAND DISPATCH
       ========================================================================= */
    canvas.addEventListener('mousedown', (e) => {
      initAudio();
      const rect = canvas.getBoundingClientRect();
      dragStart.x = e.clientX;
      dragStart.y = e.clientY;
      dragCurrent.x = e.clientX;
      dragCurrent.y = e.clientY;
      isDragging = true;
    });

    canvas.addEventListener('mousemove', (e) => {
      if (isDragging) {
        dragCurrent.x = e.clientX;
        dragCurrent.y = e.clientY;
      }
    });

    canvas.addEventListener('mouseup', (e) => {
      if (!isDragging) return;
      isDragging = false;

      const rect = canvas.getBoundingClientRect();
      const minX = Math.min(dragStart.x, dragCurrent.x) - rect.left;
      const maxX = Math.max(dragStart.x, dragCurrent.x) - rect.left;
      const minY = Math.min(dragStart.y, dragCurrent.y) - rect.top;
      const maxY = Math.max(dragStart.y, dragCurrent.y) - rect.top;

      const dragDistance = Math.hypot(maxX - minX, maxY - minY);

      // Check if it was a drag box selection
      if (dragDistance > 14 && mode === 'select') {
        const boxed = units.filter(u => {
          if (u.house !== 'Atreides' || u.hp <= 0 || u.airlifted) return false;
          const px = u.x * TILE, py = u.y * TILE;
          return px >= minX && px <= maxX && py >= minY && py <= maxY;
        });

        if (boxed.length > 0) {
          selectedUnits = boxed;
          selectedUnit = boxed[0];
          playSound('click');
          logMsg(`Selected squad of ${boxed.length} Atreides units.`, 'sys');
          return;
        }
      }

      // Single Click Handling
      const wx = Math.max(0.2, Math.min(W - 0.2, (e.clientX - rect.left) / TILE));
      const wy = Math.max(0.2, Math.min(H - 0.2, (e.clientY - rect.top) / TILE));
      const gx = Math.max(0, Math.min(W - 1, Math.floor(wx)));
      const gy = Math.max(0, Math.min(H - 1, Math.floor(wy)));

      if (mode === 'select') {
        const clicked = units.find(u => u.house === 'Atreides' && Math.hypot(u.x - wx, u.y - wy) < 0.85);
        if (clicked) {
          selectedUnits = [clicked];
          selectedUnit = clicked;
          playSound('click');
          logMsg(`Selected ${clicked.type} at (${clicked.x.toFixed(1)}, ${clicked.y.toFixed(1)}). Click to order.`, 'sys');
        } else if (selectedUnits.length > 0) {
          // Tactical formation dispatch for selected squad
          playSound('click');
          addWaypoint(wx, wy);

          selectedUnits.forEach((u, idx) => {
            if (u.hp <= 0 || u.airlifted) return;
            const row = Math.floor(idx / 3);
            const col = idx % 3;
            u.tx = Math.max(0.4, Math.min(W - 0.4, wx + (col - 1) * 0.8));
            u.ty = Math.max(0.4, Math.min(H - 0.4, wy + row * 0.8));
          });
          logMsg(`Dispatched squad of ${selectedUnits.length} units to (${wx.toFixed(1)}, ${wy.toFixed(1)}).`, 'sys');
        }
      } else if (mode === 'Concrete') {
        if (credits.Atreides < 50) { logMsg('Need 50 credits for Concrete.', 'economy'); return; }
        credits.Atreides -= 50;
        tiles[gy][gx] = 'CONCRETE';
        playSound('build');
        logMsg(`Placed Concrete Slab at (${gx}, ${gy}).`, 'economy');
        setMode('select');
      } else {
        const spec = BUILDING_SPECS[mode] || { cost: 200, hp: 400, pProd: 0, pCons: 20 };
        if (credits.Atreides < spec.cost) { logMsg(`Need ${spec.cost} credits for ${mode}.`, 'economy'); return; }
        if (buildings.some(b => b.x === gx && b.y === gy)) { logMsg('Tile already occupied.', 'sys'); return; }
        credits.Atreides -= spec.cost;
        const onConcrete = tiles[gy][gx] === 'CONCRETE';
        const hp = onConcrete ? spec.hp : Math.round(spec.hp * 0.5);

        buildings.push({
          type: mode, house: 'Atreides', x: gx, y: gy, hp, maxHp: spec.hp,
          pProd: spec.pProd || 0, pCons: spec.pCons || 0,
          range: spec.range || 0, dmg: spec.dmg || 0
        });
        playSound('build');
        logMsg(`Constructed ${mode} at (${gx}, ${gy}) [HP ${hp}/${spec.hp}].`, 'economy');
        setMode('select');
      }
    });

    // Right-Click Instant Move for Selected Squad
    canvas.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      if (selectedUnits.length === 0) return;
      initAudio();
      const rect = canvas.getBoundingClientRect();
      const wx = Math.max(0.2, Math.min(W - 0.2, (e.clientX - rect.left) / TILE));
      const wy = Math.max(0.2, Math.min(H - 0.2, (e.clientY - rect.top) / TILE));

      playSound('click');
      addWaypoint(wx, wy);

      selectedUnits.forEach((u, idx) => {
        if (u.hp <= 0 || u.airlifted) return;
        const row = Math.floor(idx / 3);
        const col = idx % 3;
        u.tx = Math.max(0.4, Math.min(W - 0.4, wx + (col - 1) * 0.8));
        u.ty = Math.max(0.4, Math.min(H - 0.4, wy + row * 0.8));
      });
      logMsg(`Tactical move ordered for ${selectedUnits.length} units to (${wx.toFixed(1)}, ${wy.toFixed(1)}).`, 'sys');
    });

    /* =========================================================================
       GAME TICK EXECUTION (High-Level AI, Defenses & Sandworm Cycles)
       ========================================================================= */
    function stepTick() {
      tickCount++;

      // 1. Sandworm Submersion, Regeneration & Dormancy Recovery
      if (sandworm.submerged) {
        sandworm.submergeTimer--;
        sandworm.hp = Math.min(sandworm.maxHp, sandworm.hp + 25);
        if (sandworm.submergeTimer <= 0) {
          sandworm.submerged = false;
          sandworm.lastBurrowHp = sandworm.hp;
          sandworm.x = 8 + Math.random() * 8;
          sandworm.y = 8 + Math.random() * 8;
          sandworm.tx = sandworm.x; sandworm.ty = sandworm.y;
          sandworm.stamina = 100;
          logMsg("WORM SIGN! Shai-Hulud has resurfaced from deep underground!", "worm");
        }
      } else if (sandworm.dormant) {
        sandworm.dormantTimer--;
        sandworm.stamina = Math.min(100, sandworm.stamina + 15);
        if (sandworm.dormantTimer <= 0) {
          sandworm.dormant = false;
          logMsg("Shai-Hulud has reawakened from desert dormancy and resumes hunting!", "worm");
        }
      }

      // 2. Base Defenses (Gun Turrets & Repair Facility)
      for (const b of buildings) {
        if (b.hp <= 0) continue;
        if (b.type === 'GunTurret') {
          // Shoot at Sandworm if nearby
          const wormDist = Math.hypot(sandworm.x - (b.x + 0.5), sandworm.y - (b.y + 0.5));
          if (wormDist <= b.range && !sandworm.submerged && sandworm.hp > 0) {
            sandworm.hp = Math.max(0, sandworm.hp - b.dmg);
            addTracer(b.x + 0.5, b.y + 0.5, sandworm.x, sandworm.y);
            addExplosion(sandworm.x, sandworm.y);
            logMsg(`${b.house} Gun Turret fired automated salvo on Shai-Hulud!`, 'combat');
          } else {
            // Shoot at enemy units
            const target = units.find(u => u.house !== b.house && u.hp > 0 && !u.airlifted && Math.hypot(u.x - (b.x + 0.5), u.y - (b.y + 0.5)) <= b.range);
            if (target) {
              target.hp = Math.max(0, target.hp - b.dmg);
              target.lastAttacker = b;
              addTracer(b.x + 0.5, b.y + 0.5, target.x, target.y);
              addExplosion(target.x, target.y);
              logMsg(`${b.house} Gun Turret engaged enemy ${target.type}!`, 'combat');
            }
          }
        } else if (b.type === 'RepairFacility') {
          // Repair nearby allied vehicles
          for (const u of units) {
            if (u.house === b.house && u.hp < u.maxHp && Math.hypot(u.x - (b.x + 0.5), u.y - (b.y + 0.5)) <= 2.2) {
              u.hp = Math.min(u.maxHp, u.hp + 20);
            }
          }
        }
      }

      // 3. Harvester Logic
      for (const u of units) {
        if (u.hp <= 0 || u.airlifted) continue;
        if (u.type === 'Harvester') {
          const ref = buildings.find(b => b.house === u.house && b.type === 'Refinery' && b.hp > 0);
          const distToRef = ref ? Math.hypot(u.x - (ref.x + 0.5), u.y - (ref.y + 0.5)) : 999;

          if (u.spice >= u.maxSpice && ref) {
            u.tx = ref.x + 0.5;
            u.ty = ref.y + 0.5;
          } else {
            const curTileX = Math.floor(u.x), curTileY = Math.floor(u.y);
            const curTile = tiles[curTileY] ? tiles[curTileY][curTileX] : 'SAND';
            if (curTile !== 'SPICE_THICK' && curTile !== 'SPICE_THIN') {
              let closestSpice = null, minDist = 999;
              for (let y = 0; y < H; y++) {
                for (let x = 0; x < W; x++) {
                  if (tiles[y][x] === 'SPICE_THICK' || tiles[y][x] === 'SPICE_THIN') {
                    const d = Math.hypot(u.x - (x + 0.5), u.y - (y + 0.5));
                    if (d < minDist) { minDist = d; closestSpice = { x: x + 0.5, y: y + 0.5 }; }
                  }
                }
              }
              if (closestSpice) {
                u.tx = closestSpice.x;
                u.ty = closestSpice.y;
              }
            }
          }

          if (distToRef < 1.3 && u.spice > 0) {
            credits[u.house] = Math.min(maxCapacity(u.house), credits[u.house] + u.spice);
            playSound('harvest');
            logMsg(`${u.house} Harvester deposited ${u.spice} Spice credits.`, 'economy');
            u.spice = 0;
          } else {
            const curTileX = Math.floor(u.x), curTileY = Math.floor(u.y);
            if (tiles[curTileY] && tiles[curTileY][curTileX] === 'SPICE_THICK') {
              u.spice = Math.min(u.maxSpice, u.spice + 100);
              tiles[curTileY][curTileX] = 'SPICE_THIN';
            } else if (tiles[curTileY] && tiles[curTileY][curTileX] === 'SPICE_THIN') {
              u.spice = Math.min(u.maxSpice, u.spice + 50);
              tiles[curTileY][curTileX] = 'SAND';
            }
          }
        } else {
          // Combat unit AI: Shoot at Sandworm if in range
          const wormDist = Math.hypot(sandworm.x - u.x, sandworm.y - u.y);
          if (wormDist <= u.range && !sandworm.submerged && !sandworm.dormant && sandworm.hp > 0) {
            const fireAngle = Math.atan2(sandworm.y - u.y, sandworm.x - u.x);
            u.turretAngle = quantizeAngle30(fireAngle);
            sandworm.hp = Math.max(0, sandworm.hp - u.dmg);
            addTracer(u.x, u.y, sandworm.x, sandworm.y);
            addExplosion(sandworm.x, sandworm.y);
            logMsg(`${u.house} ${u.type} engaged Shai-Hulud with heavy fire! (${u.dmg} damage)`, 'combat');

            // Defensive burrow when lost 1/3 HP threshold (200 HP intervals)
            if (sandworm.hp <= sandworm.lastBurrowHp - 200 && sandworm.hp > 0) {
              sandworm.submerged = true;
              sandworm.submergeTimer = 16;
              sandworm.lastBurrowHp = sandworm.hp;
              for (let i = 0; i < 4; i++) addExplosion(sandworm.x, sandworm.y);
              playSound('worm');
              logMsg('SHAI-HULUD DEFENSIVE BURROW! Lost 1/3 health; diving deep under sand to recover!', 'worm');
            } else if (sandworm.hp <= 0) {
              sandworm.submerged = true;
              sandworm.submergeTimer = 22;
              sandworm.lastBurrowHp = 600;
              for (let i = 0; i < 5; i++) addExplosion(sandworm.x, sandworm.y);
              playSound('worm');
              logMsg('SHAI-HULUD DRIVEN OFF! The mighty Sandworm retreats deep under the sands!', 'worm');
            }
          } else {
            // Combat Unit Retaliation or Attack Target
            const enemy = (u.lastAttacker && u.lastAttacker.hp > 0 && Math.hypot((u.lastAttacker.x || 0) - u.x, (u.lastAttacker.y || 0) - u.y) <= u.range) ? u.lastAttacker
              : units.find(e => e.house !== u.house && e.hp > 0 && !e.airlifted && Math.hypot(e.x - u.x, e.y - u.y) <= u.range)
              || buildings.find(b => b.house !== u.house && b.hp > 0 && Math.hypot((b.x + 0.5) - u.x, (b.y + 0.5) - u.y) <= u.range);

            if (enemy) {
              const ex = enemy.x !== undefined ? (enemy.x + (enemy.type === 'Harvester' || enemy.type === 'CombatTank' || enemy.type === 'Trike' ? 0 : 0.5)) : enemy.x;
              const ey = enemy.y !== undefined ? (enemy.y + (enemy.type === 'Harvester' || enemy.type === 'CombatTank' || enemy.type === 'Trike' ? 0 : 0.5)) : enemy.y;
              const fireAngle = Math.atan2(ey - u.y, ex - u.x);
              u.turretAngle = quantizeAngle30(fireAngle);

              enemy.hp = Math.max(0, enemy.hp - u.dmg);
              enemy.lastAttacker = u;
              addTracer(u.x, u.y, ex, ey);
              addExplosion(ex, ey);
              logMsg(`${u.house} ${u.type} engaged target! (${u.dmg} damage)`, 'combat');
            }
          }
        }
      }

      // 4. Harkonnen Opponent AI
      if (gpuMode && tickCount % 6 === 0) {
        requestGpuMove();
      } else if (!gpuMode && tickCount % 8 === 0 && credits.Harkonnen >= 300) {
        credits.Harkonnen -= 300;
        units.push({
          type: 'CombatTank', house: 'Harkonnen', x: 20.5, y: 20.5, tx: 5.5, ty: 5.5,
          hp: 140, maxHp: 140, spice: 0, maxSpice: 0, dmg: 25, range: 4.0, angle: Math.PI, turretAngle: Math.PI,
          speed: 1.6, turnTimer: 0, airlifted: false, wormPanic: false, retreatWarning: false, lastAttacker: null
        });
        playSound('build');
        logMsg('Harkonnen deployed heavy CombatTank!', 'combat');
      }

      // 5. Sandworm Prey Selection
      if (!sandworm.submerged && !sandworm.dormant && sandworm.hp > 0) {
        const prey = units.filter(u => {
          if (u.hp <= 0 || u.airlifted) return false;
          const tx = Math.floor(u.x), ty = Math.floor(u.y);
          const t = tiles[ty] ? tiles[ty][tx] : 'SAND';
          return t !== 'ROCK' && t !== 'CONCRETE' && t !== 'MOUNTAIN' && t !== 'CRATER';
        });

        if (prey.length > 0) {
          prey.sort((a, b) => Math.hypot(a.x - sandworm.x, a.y - sandworm.y) - Math.hypot(b.x - sandworm.x, b.y - sandworm.y));
          sandworm.tx = prey[0].x;
          sandworm.ty = prey[0].y;

          if (Math.hypot(sandworm.x - prey[0].x, sandworm.y - prey[0].y) < 0.75) {
            prey[0].hp = 0;
            playSound('worm');
            addExplosion(prey[0].x, prey[0].y);
            logMsg(`WORM SIGN! Shai-Hulud devoured ${prey[0].house} ${prey[0].type}!`, 'worm');
          }
        }
      }

      units = units.filter(u => u.hp > 0);
      selectedUnits = selectedUnits.filter(u => u.hp > 0);
      buildings = buildings.filter(b => b.hp > 0);
      updateHud();
    }

    /* =========================================================================
       INTELLIGENT KINEMATICS, WORM UNDULATION & TACTICAL RETREAT
       ========================================================================= */
    function updateKinematics(dt) {
      // 1. Unit Movement, Retaliation & Tactical Retreat
      for (const u of units) {
        if (u.hp <= 0 || u.airlifted) continue;

        // Sandworm Threat Detection
        const wormDist = Math.hypot(sandworm.x - u.x, sandworm.y - u.y);
        const curTileX = Math.floor(u.x), curTileY = Math.floor(u.y);
        const curTile = tiles[curTileY] ? tiles[curTileY][curTileX] : 'SAND';
        const onSafeGround = (curTile === 'ROCK' || curTile === 'CONCRETE' || curTile === 'MOUNTAIN' || curTile === 'CRATER');

        // Flee to rock when Sandworm is near on sand
        if (wormDist < 4.5 && !onSafeGround && !sandworm.submerged && !sandworm.dormant) {
          let nearestSafe = null, minSafeDist = 999;
          for (let y = 0; y < H; y++) {
            for (let x = 0; x < W; x++) {
              const t = tiles[y][x];
              if (t === 'ROCK' || t === 'CONCRETE' || t === 'MOUNTAIN' || t === 'CRATER') {
                const d = Math.hypot(u.x - (x + 0.5), u.y - (y + 0.5));
                if (d < minSafeDist) { minSafeDist = d; nearestSafe = { x: x + 0.5, y: y + 0.5 }; }
              }
            }
          }
          if (nearestSafe) {
            u.tx = nearestSafe.x;
            u.ty = nearestSafe.y;
            if (!u.wormPanic) {
              u.wormPanic = true;
              logMsg(`SEISMIC ALERT! ${u.house} ${u.type} retreating to rocky safety!`, 'worm');
            }
          }
        } else if (wormDist >= 5.5) {
          u.wormPanic = false;
        }

        // Tactical Evaluation: Outnumbered Retreat vs Stand Ground
        if (u.lastAttacker && u.lastAttacker.hp > 0) {
          const nearbyEnemies = units.filter(e => e.house !== u.house && e.hp > 0 && Math.hypot(e.x - u.x, e.y - u.y) < 4.5);
          const nearbyAllies = units.filter(a => a.house === u.house && a.hp > 0 && Math.hypot(a.x - u.x, a.y - u.y) < 4.5);
          const hpRatio = u.hp / u.maxHp;

          // If outnumbered by 2+ or severely wounded in combat, tactically retreat to base!
          if (nearbyEnemies.length >= nearbyAllies.length + 1 || (hpRatio < 0.35 && nearbyEnemies.length > 0)) {
            const homeBuildings = buildings.filter(b => b.house === u.house && b.hp > 0);
            if (homeBuildings.length > 0) {
              homeBuildings.sort((a, b) => Math.hypot(u.x - (a.x + 0.5), u.y - (a.y + 0.5)) - Math.hypot(u.x - (b.x + 0.5), u.y - (b.y + 0.5)));
              u.tx = homeBuildings[0].x + 0.5;
              u.ty = homeBuildings[0].y + 0.5;
              if (!u.retreatWarning) {
                u.retreatWarning = true;
                logMsg(`TACTICAL RETREAT! ${u.house} ${u.type} outmatched; falling back to base defense!`, 'combat');
              }
            }
          }
        }

        const dist = Math.hypot(u.tx - u.x, u.ty - u.y);
        if (dist > 0.08) {
          const desiredAngle = Math.atan2(u.ty - u.y, u.tx - u.x);
          u.turnTimer = (u.turnTimer || 0) + dt;

          if (u.turnTimer >= 0.06) {
            u.turnTimer = 0;
            u.angle = stepAngleTowards30(u.angle, desiredAngle);
            if (u.type !== 'CombatTank') {
              u.turretAngle = u.angle;
            }
          }

          const moveStep = Math.min(dist, u.speed * dt);
          u.x = Math.max(0.4, Math.min(W - 0.4, u.x + Math.cos(u.angle) * moveStep));
          u.y = Math.max(0.4, Math.min(H - 0.4, u.y + Math.sin(u.angle) * moveStep));

          if (Math.random() < 0.22) {
            addDust(u.x, u.y);
          }
        }
      }

      // 2. Ornithopter / Carryall Aerial Logistics
      for (const c of carryalls) {
        c.wingPhase = (c.wingPhase + dt * 32) % (Math.PI * 2);

        if (c.state === 'idle') {
          const needingAirlift = units.find(u => {
            if (u.house !== c.house || u.type !== 'Harvester' || u.airlifted || u.hp <= 0) return false;
            const wormDist = Math.hypot(sandworm.x - u.x, sandworm.y - u.y);
            const curTileX = Math.floor(u.x), curTileY = Math.floor(u.y);
            const curTile = tiles[curTileY] ? tiles[curTileY][curTileX] : 'SAND';
            const onSand = curTile !== 'ROCK' && curTile !== 'CONCRETE';
            return u.spice >= u.maxSpice || (wormDist < 4.2 && onSand && !sandworm.submerged && !sandworm.dormant);
          });

          if (needingAirlift && !carryalls.some(other => other !== c && other.targetHarvester === needingAirlift)) {
            c.state = 'flying_to_pickup';
            c.targetHarvester = needingAirlift;
            c.tx = needingAirlift.x;
            c.ty = needingAirlift.y;
            logMsg(`${c.house} Carryall scrambled to airlift Harvester!`, 'economy');
          }
        } else if (c.state === 'flying_to_pickup') {
          if (!c.targetHarvester || c.targetHarvester.hp <= 0) {
            c.state = 'returning';
            c.targetHarvester = null;
            c.tx = c.house === 'Atreides' ? 2.5 : 21.5;
            c.ty = c.house === 'Atreides' ? 2.5 : 21.5;
          } else {
            c.tx = c.targetHarvester.x;
            c.ty = c.targetHarvester.y;
            if (Math.hypot(c.x - c.targetHarvester.x, c.y - c.targetHarvester.y) < 0.5) {
              c.state = 'carrying_to_refinery';
              c.carryingUnit = c.targetHarvester;
              c.targetHarvester.airlifted = true;
              const ref = buildings.find(b => b.house === c.house && b.type === 'Refinery' && b.hp > 0);
              c.tx = ref ? ref.x + 0.5 : c.x;
              c.ty = ref ? ref.y + 0.5 : c.y;
              playSound('harvest');
              logMsg(`${c.house} Carryall hooked Harvester! Flying to Refinery.`, 'economy');
            }
          }
        } else if (c.state === 'carrying_to_refinery') {
          if (c.carryingUnit) {
            c.carryingUnit.x = c.x;
            c.carryingUnit.y = c.y;
          }
          if (Math.hypot(c.x - c.tx, c.y - c.ty) < 0.5) {
            if (c.carryingUnit) {
              c.carryingUnit.airlifted = false;
              if (c.carryingUnit.spice > 0) {
                credits[c.house] = Math.min(maxCapacity(c.house), credits[c.house] + c.carryingUnit.spice);
                c.carryingUnit.spice = 0;
              }
            }
            c.carryingUnit = null;
            c.targetHarvester = null;
            c.state = 'returning';
            c.tx = c.house === 'Atreides' ? 2.5 : 21.5;
            c.ty = c.house === 'Atreides' ? 2.5 : 21.5;
            playSound('harvest');
            logMsg(`${c.house} Carryall safely landed Harvester at Refinery!`, 'economy');
          }
        } else if (c.state === 'returning') {
          if (Math.hypot(c.x - c.tx, c.y - c.ty) < 0.5) {
            c.state = 'idle';
          }
        }

        const cDist = Math.hypot(c.tx - c.x, c.ty - c.y);
        if (cDist > 0.08) {
          const flightAngle = Math.atan2(c.ty - c.y, c.tx - c.x);
          c.angle = stepAngleTowards30(c.angle, flightAngle);
          const flightStep = Math.min(cDist, c.speed * dt);
          c.x += Math.cos(c.angle) * flightStep;
          c.y += Math.sin(c.angle) * flightStep;
        }
      }

      // 3. Sandworm Sinusoidal Undulation, Fatigue & Slither Kinematics
      if (!sandworm.submerged && !sandworm.dormant) {
        const wDist = Math.hypot(sandworm.tx - sandworm.x, sandworm.ty - sandworm.y);
        if (wDist > 0.1) {
          // Stamina depletion during active chase
          sandworm.stamina = Math.max(0, sandworm.stamina - dt * 4.5);
          const fatigueRatio = sandworm.stamina / 100;
          sandworm.speed = sandworm.baseSpeed * Math.max(0.65, fatigueRatio);

          // If stamina exhausted, worm burrows to deeper place and stays unnoticed
          if (sandworm.stamina <= 0) {
            sandworm.dormant = true;
            sandworm.dormantTimer = 16;
            logMsg("Shai-Hulud has grown fatigued from the chase and lies dormant in deep sand.", "worm");
          }

          // Sinusoidal transverse wave oscillation
          sandworm.wavePhase = (sandworm.wavePhase || 0) + dt * 4.2;
          const directAngle = Math.atan2(sandworm.ty - sandworm.y, sandworm.tx - sandworm.x);
          const waveOscillation = Math.sin(sandworm.wavePhase) * 0.42;
          const heading = directAngle + waveOscillation;

          sandworm.angle = quantizeAngle30(heading);
          const wStep = Math.min(wDist, sandworm.speed * dt);
          sandworm.x += Math.cos(heading) * wStep;
          sandworm.y += Math.sin(heading) * wStep;

          // Undulating body segment chain with lateral waving
          for (let i = 0; i < sandworm.segments.length; i++) {
            const leader = i === 0 ? sandworm : sandworm.segments[i - 1];
            const seg = sandworm.segments[i];
            const d = Math.hypot(leader.x - seg.x, leader.y - seg.y);
            if (d > 0.45) {
              const a = Math.atan2(leader.y - seg.y, leader.x - seg.x);
              seg.x = leader.x - Math.cos(a) * 0.45;
              seg.y = leader.y - Math.sin(a) * 0.45;
            }
            seg.waveOffset = Math.sin(sandworm.wavePhase - (i + 1) * 0.75) * 3.5;
          }
        }
      }
    }

    function updateHud() {
      const pProd = buildings.filter(b => b.house === 'Atreides').reduce((s, b) => s + b.pProd, 0);
      const pCons = buildings.filter(b => b.house === 'Atreides').reduce((s, b) => s + b.pCons, 0);
      const eff = (pCons <= 0 || pProd >= pCons) ? 100 : Math.max(25, Math.round((pProd / pCons) * 100));

      document.getElementById('hud-credits').textContent = credits.Atreides;
      document.getElementById('hud-capacity').textContent = maxCapacity('Atreides');
      document.getElementById('hud-power').textContent = `${pProd} / ${pCons} (${eff}%)`;
      document.getElementById('hud-tick').textContent = tickCount;

      const atrAlive = buildings.some(b => b.house === 'Atreides') || units.some(u => u.house === 'Atreides');
      const harAlive = buildings.some(b => b.house === 'Harkonnen') || units.some(u => u.house === 'Harkonnen');
      const statElem = document.getElementById('hud-status');
      if (!harAlive) {
        statElem.textContent = 'Atreides Victory!';
        statElem.style.color = '#38bdf8';
      } else if (!atrAlive) {
        statElem.textContent = 'Harkonnen Victory!';
        statElem.style.color = '#f87171';
      } else {
        statElem.textContent = 'Battle Active';
        statElem.style.color = '#22c55e';
      }
    }

    /* =========================================================================
       HIGH-DETAIL PROCEDURAL GRAPHICS RENDERING ENGINE
       ========================================================================= */
    function renderTile(x, y, tileType, animTime) {
      const px = x * TILE, py = y * TILE;

      if (tileType === 'SAND') {
        ctx.fillStyle = '#d4a359';
        ctx.fillRect(px, py, TILE, TILE);
        ctx.strokeStyle = '#c69348';
        ctx.lineWidth = 1;
        ctx.beginPath();
        const o = (x * 7 + y * 13) % 8;
        ctx.moveTo(px, py + 6 + o);
        ctx.quadraticCurveTo(px + 14, py + 2 + o, px + 28, py + 8 + o);
        ctx.moveTo(px, py + 18 + o);
        ctx.quadraticCurveTo(px + 14, py + 22 + o, px + 28, py + 16 + o);
        ctx.stroke();
      } else if (tileType === 'DUNES') {
        ctx.fillStyle = '#be8a40';
        ctx.fillRect(px, py, TILE, TILE);
        ctx.strokeStyle = '#a67530';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(px, py + 14);
        ctx.quadraticCurveTo(px + 14, py + 6, px + 28, py + 18);
        ctx.stroke();
      } else if (tileType === 'ROCK') {
        ctx.fillStyle = '#474c58';
        ctx.fillRect(px, py, TILE, TILE);
        ctx.fillStyle = '#5a6170';
        ctx.beginPath();
        ctx.moveTo(px, py); ctx.lineTo(px + TILE, py);
        ctx.lineTo(px + TILE - 3, py + 3); ctx.lineTo(px + 3, py + 3);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = '#272a33';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(px + 4, py + 8); ctx.lineTo(px + 14, py + 18); ctx.lineTo(px + 24, py + 14);
        ctx.stroke();
      } else if (tileType === 'MOUNTAIN') {
        ctx.fillStyle = '#2d323b';
        ctx.fillRect(px, py, TILE, TILE);
        ctx.fillStyle = '#424956';
        ctx.beginPath();
        ctx.moveTo(px + 14, py + 2);
        ctx.lineTo(px + 26, py + 26);
        ctx.lineTo(px + 2, py + 26);
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = '#cbd5e1';
        ctx.fillRect(px + 13, py + 3, 2, 3);
      } else if (tileType === 'CRATER') {
        ctx.fillStyle = '#3a3835';
        ctx.fillRect(px, py, TILE, TILE);
        ctx.fillStyle = '#1c1b18';
        ctx.beginPath();
        ctx.arc(px + 14, py + 14, 10, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#5a544b';
        ctx.lineWidth = 1.5;
        ctx.stroke();
      } else if (tileType === 'CONCRETE') {
        ctx.fillStyle = '#838a96';
        ctx.fillRect(px, py, TILE, TILE);
        ctx.strokeStyle = '#383f4d';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(px + 14, py); ctx.lineTo(px + 14, py + 28);
        ctx.moveTo(px, py + 14); ctx.lineTo(px + 28, py + 14);
        ctx.stroke();
        ctx.fillStyle = '#cbd5e1';
        ctx.fillRect(px + 2, py + 2, 2, 2); ctx.fillRect(px + 24, py + 2, 2, 2);
        ctx.fillRect(px + 2, py + 24, 2, 2); ctx.fillRect(px + 24, py + 24, 2, 2);
      } else if (tileType === 'SPICE_THIN') {
        ctx.fillStyle = '#cb7536';
        ctx.fillRect(px, py, TILE, TILE);
        const spark = Math.sin(animTime * 0.005 + x * 2 + y * 3);
        ctx.fillStyle = spark > 0.3 ? '#fef08a' : '#d97706';
        ctx.fillRect(px + 6, py + 6, 3, 3);
        ctx.fillRect(px + 18, py + 12, 2, 2);
        ctx.fillRect(px + 10, py + 20, 3, 3);
      } else if (tileType === 'SPICE_THICK') {
        ctx.fillStyle = '#991b1b';
        ctx.fillRect(px, py, TILE, TILE);
        const pulse = 0.5 + 0.5 * Math.sin(animTime * 0.008 + x + y);
        ctx.fillStyle = `rgba(245, 158, 11, ${0.4 + pulse * 0.4})`;
        ctx.fillRect(px + 3, py + 3, 22, 22);
        ctx.fillStyle = '#fef08a';
        ctx.fillRect(px + 8, py + 8, 4, 4);
        ctx.fillRect(px + 16, py + 16, 4, 4);
      }

      ctx.strokeStyle = 'rgba(0, 0, 0, 0.06)';
      ctx.lineWidth = 1;
      ctx.strokeRect(px, py, TILE, TILE);
    }

    function renderBuilding(b, animTime) {
      const px = b.x * TILE, py = b.y * TILE;
      const houseCol = HOUSE_COLORS[b.house] || HOUSE_COLORS.Atreides;

      ctx.fillStyle = '#232733';
      ctx.fillRect(px + 2, py + 2, TILE - 4, TILE - 4);

      if (b.type === 'ConstructionYard') {
        ctx.fillStyle = houseCol.dark;
        ctx.fillRect(px + 3, py + 3, TILE - 6, TILE - 6);
        ctx.fillStyle = houseCol.main;
        ctx.fillRect(px + 6, py + 6, TILE - 12, TILE - 12);

        const radarAngle = animTime * 0.003;
        ctx.save();
        ctx.translate(px + 14, py + 12);
        ctx.rotate(radarAngle);
        ctx.strokeStyle = '#f8fafc';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(0, 0, 5, 0, Math.PI);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(0, 0); ctx.lineTo(0, -5);
        ctx.stroke();
        ctx.restore();

      } else if (b.type === 'WindTrap') {
        ctx.fillStyle = houseCol.dark;
        ctx.fillRect(px + 3, py + 3, TILE - 6, TILE - 6);
        ctx.fillStyle = '#0f172a';
        ctx.beginPath();
        ctx.arc(px + 14, py + 14, 8, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = houseCol.light;
        ctx.lineWidth = 1.5;
        ctx.stroke();

        const fanAngle = animTime * 0.012;
        ctx.save();
        ctx.translate(px + 14, py + 14);
        ctx.rotate(fanAngle);
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 1.5;
        for (let i = 0; i < 3; i++) {
          ctx.rotate((Math.PI * 2) / 3);
          ctx.beginPath();
          ctx.moveTo(0, 0); ctx.lineTo(0, 6);
          ctx.stroke();
        }
        ctx.restore();

      } else if (b.type === 'Refinery') {
        ctx.fillStyle = houseCol.dark;
        ctx.fillRect(px + 3, py + 3, TILE - 6, TILE - 6);
        ctx.fillStyle = '#64748b';
        ctx.fillRect(px + 5, py + 6, 7, 12);
        ctx.fillRect(px + 16, py + 6, 7, 12);

        const glow = 0.5 + 0.5 * Math.sin(animTime * 0.01);
        ctx.fillStyle = `rgba(249, 115, 22, ${0.4 + glow * 0.5})`;
        ctx.fillRect(px + 9, py + 16, 10, 4);

      } else if (b.type === 'Silo') {
        ctx.fillStyle = houseCol.dark;
        ctx.fillRect(px + 5, py + 4, 18, 20);
        ctx.fillStyle = '#94a3b8';
        ctx.fillRect(px + 5, py + 9, 18, 2);
        ctx.fillRect(px + 5, py + 17, 18, 2);
        ctx.fillStyle = '#ea580c';
        ctx.fillRect(px + 12, py + 8, 4, 11);

      } else if (b.type === 'HeavyFactory') {
        // Dune 2000 Heavy Factory: dual chimneys, crane gantry, vehicle roll-out door
        ctx.fillStyle = houseCol.dark;
        ctx.fillRect(px + 2, py + 2, TILE - 4, TILE - 4);
        ctx.fillStyle = '#334155';
        ctx.fillRect(px + 4, py + 4, 8, 18);
        ctx.fillRect(px + 16, py + 4, 8, 18);
        ctx.fillStyle = houseCol.light;
        ctx.fillRect(px + 6, py + 16, 16, 8); // Roll-out door
        ctx.strokeStyle = '#facc15';
        ctx.lineWidth = 1.2;
        ctx.strokeRect(px + 5, py + 3, 18, 4); // Crane beam

      } else if (b.type === 'HighTech') {
        // High-Tech Factory: central dome with radar dish and landing beacon
        ctx.fillStyle = houseCol.dark;
        ctx.fillRect(px + 3, py + 3, TILE - 6, TILE - 6);
        ctx.fillStyle = '#0f172a';
        ctx.beginPath();
        ctx.arc(px + 14, py + 14, 9, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        // Helipad cross
        ctx.fillStyle = '#38bdf8';
        ctx.fillRect(px + 12, py + 8, 4, 12);
        ctx.fillRect(px + 8, py + 12, 12, 4);

      } else if (b.type === 'GunTurret') {
        // Automated Gun Turret
        ctx.fillStyle = '#334155';
        ctx.fillRect(px + 4, py + 4, TILE - 8, TILE - 8);
        ctx.fillStyle = houseCol.main;
        ctx.beginPath();
        ctx.arc(px + 14, py + 14, 6, 0, Math.PI * 2);
        ctx.fill();
        // Dual barrels
        ctx.strokeStyle = '#e2e8f0';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(px + 14, py + 12); ctx.lineTo(px + 24, py + 12);
        ctx.moveTo(px + 14, py + 16); ctx.lineTo(px + 24, py + 16);
        ctx.stroke();

      } else if (b.type === 'RepairFacility') {
        // Repair Pad
        ctx.fillStyle = '#1e293b';
        ctx.fillRect(px + 3, py + 3, TILE - 6, TILE - 6);
        ctx.fillStyle = '#22c55e';
        ctx.fillRect(px + 12, py + 6, 4, 16);
        ctx.fillRect(px + 6, py + 12, 16, 4);
        ctx.strokeStyle = '#64748b';
        ctx.lineWidth = 1;
        ctx.strokeRect(px + 3, py + 3, TILE - 6, TILE - 6);

      } else if (b.type === 'Palace') {
        // Supreme House Palace
        ctx.fillStyle = houseCol.dark;
        ctx.fillRect(px + 2, py + 2, TILE - 4, TILE - 4);
        ctx.fillStyle = b.house === 'Atreides' ? '#f59e0b' : '#991b1b';
        ctx.beginPath();
        ctx.moveTo(px + 4, py + 24); ctx.lineTo(px + 14, py + 4); ctx.lineTo(px + 24, py + 24);
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = houseCol.light;
        ctx.fillRect(px + 11, py + 12, 6, 12); // Royal entrance
      }

      // Health bar
      const hpPct = Math.max(0, b.hp / b.maxHp);
      ctx.fillStyle = 'rgba(0,0,0,0.7)';
      ctx.fillRect(px + 3, py + 1, 22, 2.5);
      ctx.fillStyle = hpPct > 0.5 ? '#22c55e' : (hpPct > 0.25 ? '#eab308' : '#ef4444');
      ctx.fillRect(px + 3, py + 1, Math.floor(22 * hpPct), 2.5);
    }

    function renderUnit(u, animTime) {
      if (u.airlifted) return;
      const cx = u.x * TILE, cy = u.y * TILE;
      const houseCol = HOUSE_COLORS[u.house] || HOUSE_COLORS.Atreides;

      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(u.angle || 0);

      if (u.type === 'CombatTank') {
        ctx.fillStyle = '#1e293b';
        ctx.fillRect(-11, -8, 22, 4);
        ctx.fillRect(-11, 4, 22, 4);

        ctx.fillStyle = houseCol.main;
        ctx.fillRect(-7, -4, 14, 8);
        ctx.fillStyle = houseCol.dark;
        ctx.fillRect(-9, -3, 3, 6);

        // Turret with independent 30-degree rotation
        ctx.save();
        ctx.rotate((u.turretAngle !== undefined ? u.turretAngle : u.angle) - u.angle);

        ctx.fillStyle = houseCol.light;
        ctx.beginPath();
        ctx.arc(0, 0, 4, 0, Math.PI * 2);
        ctx.fill();

        ctx.strokeStyle = '#e2e8f0';
        ctx.lineWidth = 2.2;
        ctx.beginPath();
        ctx.moveTo(2, -1.2); ctx.lineTo(12, -1.2);
        ctx.moveTo(2, 1.2); ctx.lineTo(12, 1.2);
        ctx.stroke();

        ctx.restore();

      } else if (u.type === 'Harvester') {
        ctx.fillStyle = '#334155';
        ctx.fillRect(-12, -9, 24, 5);
        ctx.fillRect(-12, 4, 24, 5);

        ctx.fillStyle = houseCol.main;
        ctx.fillRect(-8, -5, 16, 10);

        ctx.fillStyle = '#0f172a';
        ctx.fillRect(7, -7, 4, 14);
        ctx.fillStyle = '#f59e0b';
        ctx.fillRect(9, -5, 2, 10);

        const loadPct = (u.spice || 0) / (u.maxSpice || 700);
        if (loadPct > 0) {
          ctx.fillStyle = '#ea580c';
          ctx.fillRect(-7, -3, Math.floor(12 * loadPct), 6);
        }

      } else if (u.type === 'Trike') {
        ctx.fillStyle = '#0f172a';
        ctx.fillRect(7, -2.5, 5, 5);
        ctx.fillRect(-8, -7, 5, 4);
        ctx.fillRect(-8, 3, 5, 4);

        ctx.fillStyle = houseCol.main;
        ctx.beginPath();
        ctx.moveTo(7, 0); ctx.lineTo(-6, -5); ctx.lineTo(-6, 5);
        ctx.closePath();
        ctx.fill();

        ctx.strokeStyle = '#cbd5e1';
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(3, -2.5); ctx.lineTo(9, -2.5);
        ctx.moveTo(3, 2.5); ctx.lineTo(9, 2.5);
        ctx.stroke();
      }

      ctx.restore();

      // Selection ring (supports squad multi-selection)
      if (selectedUnits.includes(u)) {
        ctx.strokeStyle = '#facc15';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([3, 3]);
        ctx.beginPath();
        ctx.arc(cx, cy, 14, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);
      }

      // Unit health bar
      const hpPct = Math.max(0, u.hp / u.maxHp);
      ctx.fillStyle = 'rgba(0,0,0,0.7)';
      ctx.fillRect(cx - 9, cy - 13, 18, 2.5);
      ctx.fillStyle = hpPct > 0.5 ? '#22c55e' : (hpPct > 0.25 ? '#eab308' : '#ef4444');
      ctx.fillRect(cx - 9, cy - 13, Math.floor(18 * hpPct), 2.5);
    }

    function renderCarryall(c, animTime) {
      const cx = c.x * TILE, cy = c.y * TILE;
      const houseCol = HOUSE_COLORS[c.house] || HOUSE_COLORS.Atreides;

      // Ground Shadow
      ctx.save();
      ctx.translate(cx + 6, cy + 12);
      ctx.rotate(c.angle);
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      ctx.beginPath();
      ctx.ellipse(0, 0, 14, 6, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      // Carried Unit Suspension
      if (c.carryingUnit) {
        ctx.strokeStyle = '#cbd5e1';
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(cx - 6, cy); ctx.lineTo(cx - 4, cy + 8);
        ctx.moveTo(cx + 6, cy); ctx.lineTo(cx + 4, cy + 8);
        ctx.stroke();

        ctx.save();
        ctx.translate(cx, cy + 8);
        ctx.rotate(c.carryingUnit.angle || 0);
        ctx.fillStyle = houseCol.main;
        ctx.fillRect(-7, -4, 14, 8);
        ctx.fillStyle = '#334155';
        ctx.fillRect(-9, -6, 18, 3);
        ctx.fillRect(-9, 3, 18, 3);
        ctx.restore();
      }

      // Ornithopter Craft
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(c.angle);

      ctx.fillStyle = houseCol.dark;
      ctx.beginPath();
      ctx.ellipse(0, 0, 13, 5, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = houseCol.light;
      ctx.fillRect(-3, -2, 7, 4);

      ctx.fillStyle = '#38bdf8';
      ctx.beginPath();
      ctx.arc(6, 0, 2.5, 0, Math.PI * 2);
      ctx.fill();

      // Flapping Dragonfly Wings
      const flap = Math.sin(c.wingPhase) * 0.45;
      ctx.strokeStyle = 'rgba(226, 232, 240, 0.85)';
      ctx.lineWidth = 1.6;

      ctx.save();
      ctx.translate(2, -3);
      ctx.rotate(-0.4 + flap);
      ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(0, -14); ctx.stroke();
      ctx.restore();

      ctx.save();
      ctx.translate(2, 3);
      ctx.rotate(0.4 - flap);
      ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(0, 14); ctx.stroke();
      ctx.restore();

      ctx.save();
      ctx.translate(-4, -3);
      ctx.rotate(-0.8 - flap * 0.8);
      ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(0, -11); ctx.stroke();
      ctx.restore();

      ctx.save();
      ctx.translate(-4, 3);
      ctx.rotate(0.8 + flap * 0.8);
      ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(0, 11); ctx.stroke();
      ctx.restore();

      ctx.restore();
    }

    /* Shai-Hulud Sandworm with Sinusoidal Undulation, Fatigue & Boss Healthbar */
    function renderSandworm(animTime) {
      if (sandworm.submerged) {
        const rx = sandworm.x * TILE, ry = sandworm.y * TILE;
        ctx.strokeStyle = 'rgba(180, 83, 9, 0.3)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(rx, ry, (animTime * 0.02) % 22, 0, Math.PI * 2);
        ctx.stroke();
        return;
      }

      if (sandworm.dormant) {
        // Dormant subterranean dust mound
        const rx = sandworm.x * TILE, ry = sandworm.y * TILE;
        ctx.fillStyle = 'rgba(120, 53, 15, 0.4)';
        ctx.beginPath();
        ctx.ellipse(rx, ry, 18, 10, 0, 0, Math.PI * 2);
        ctx.fill();
        return;
      }

      const headX = sandworm.x * TILE, headY = sandworm.y * TILE;

      // Sinusoidal undulating body segments with lateral offset
      if (sandworm.segments) {
        for (let i = sandworm.segments.length - 1; i >= 0; i--) {
          const seg = sandworm.segments[i];
          const segX = seg.x * TILE + Math.cos(sandworm.angle + Math.PI / 2) * (seg.waveOffset || 0);
          const segY = seg.y * TILE + Math.sin(sandworm.angle + Math.PI / 2) * (seg.waveOffset || 0);
          const rad = 6 + (4 - i);
          ctx.fillStyle = '#78350f';
          ctx.beginPath();
          ctx.arc(segX, segY, rad, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // Seismic Sand Displacement Shockwaves
      const wave = (animTime * 0.04) % 18;
      ctx.strokeStyle = 'rgba(180, 83, 9, 0.4)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(headX, headY, 12 + wave, 0, Math.PI * 2);
      ctx.stroke();

      // Maw & Ivory Teeth
      ctx.fillStyle = '#b45309';
      ctx.beginPath();
      ctx.arc(headX, headY, 12, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#451a03';
      ctx.beginPath();
      ctx.arc(headX, headY, 8, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#fef3c7';
      for (let i = 0; i < 8; i++) {
        const a = (i * Math.PI) / 4 + sandworm.angle;
        const tx = headX + Math.cos(a) * 6;
        const ty = headY + Math.sin(a) * 6;
        ctx.fillRect(tx - 1, ty - 1, 2, 2);
      }

      // === SHAI-HULUD BOSS HEALTHBAR ===
      const hx = headX, hy = headY - 22;
      const barW = 56, barH = 5;

      ctx.fillStyle = 'rgba(15, 23, 42, 0.85)';
      ctx.fillRect(hx - barW / 2 - 1, hy - 1, barW + 2, barH + 2);
      ctx.strokeStyle = '#78350f';
      ctx.lineWidth = 1;
      ctx.strokeRect(hx - barW / 2 - 1, hy - 1, barW + 2, barH + 2);

      const pct = Math.max(0, sandworm.hp / sandworm.maxHp);
      ctx.fillStyle = pct > 0.5 ? '#eab308' : (pct > 0.25 ? '#f97316' : '#ef4444');
      ctx.fillRect(hx - barW / 2, hy, Math.floor(barW * pct), barH);

      // Stamina pip indicator (fatigue meter)
      ctx.fillStyle = '#38bdf8';
      ctx.fillRect(hx - barW / 2, hy + barH + 1, Math.floor(barW * (sandworm.stamina / 100)), 1.5);

      ctx.fillStyle = '#fef08a';
      ctx.font = 'bold 9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(`SHAI-HULUD [${sandworm.hp}/${sandworm.maxHp}]`, hx, hy - 3);
      ctx.textAlign = 'left';
    }

    function renderParticles() {
      for (const p of particles) {
        const alpha = p.life / p.maxLife;
        if (p.type === 'spark') {
          ctx.fillStyle = p.color;
          ctx.globalAlpha = alpha;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
        } else if (p.type === 'dust') {
          ctx.fillStyle = '#d4a359';
          ctx.globalAlpha = alpha * 0.6;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
        } else if (p.type === 'shockwave') {
          ctx.strokeStyle = '#f59e0b';
          ctx.globalAlpha = alpha * 0.7;
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.stroke();
        } else if (p.type === 'waypoint') {
          ctx.strokeStyle = '#22c55e';
          ctx.globalAlpha = alpha * 0.8;
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(p.x - 4, p.y); ctx.lineTo(p.x + 4, p.y);
          ctx.moveTo(p.x, p.y - 4); ctx.lineTo(p.x, p.y + 4);
          ctx.stroke();
        } else if (p.type === 'tracer') {
          ctx.strokeStyle = '#fef08a';
          ctx.globalAlpha = alpha;
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.moveTo(p.x1, p.y1);
          ctx.lineTo(p.x2, p.y2);
          ctx.stroke();
        }
      }
      ctx.globalAlpha = 1.0;
    }

    function renderMarqueeBox() {
      if (isDragging && mode === 'select') {
        const rect = canvas.getBoundingClientRect();
        const bx = Math.min(dragStart.x, dragCurrent.x) - rect.left;
        const by = Math.min(dragStart.y, dragCurrent.y) - rect.top;
        const bw = Math.abs(dragCurrent.x - dragStart.x);
        const bh = Math.abs(dragCurrent.y - dragStart.y);

        if (bw > 4 || bh > 4) {
          ctx.strokeStyle = '#22c55e';
          ctx.lineWidth = 1.5;
          ctx.setLineDash([4, 4]);
          ctx.strokeRect(bx, by, bw, bh);
          ctx.fillStyle = 'rgba(34, 197, 94, 0.12)';
          ctx.fillRect(bx, by, bw, bh);
          ctx.setLineDash([]);
        }
      }
    }

    /* =========================================================================
       24x24 RADAR MINIMAP CANVAS
       ========================================================================= */
    function renderRadar(animTime) {
      const rw = radarCanvas.width, rh = radarCanvas.height;
      radarCtx.fillStyle = '#090d14';
      radarCtx.fillRect(0, 0, rw, rh);

      const cellW = rw / W, cellH = rh / H;

      // Render mini terrain
      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          const t = tiles[y][x];
          radarCtx.fillStyle = t === 'ROCK' ? '#333842' :
            (t === 'MOUNTAIN' ? '#1e222a' :
            (t === 'CRATER' ? '#1c1b18' :
            (t === 'CONCRETE' ? '#64748b' :
            (t === 'SPICE_THICK' ? '#dc2626' :
            (t === 'SPICE_THIN' ? '#d97706' :
            (t === 'DUNES' ? '#926a2c' : '#b4883b'))))));
          radarCtx.fillRect(x * cellW, y * cellH, cellW, cellH);
        }
      }

      // Render buildings
      for (const b of buildings) {
        radarCtx.fillStyle = b.house === 'Atreides' ? '#3b82f6' : '#ef4444';
        radarCtx.fillRect(b.x * cellW, b.y * cellH, cellW * 1.2, cellH * 1.2);
      }

      // Render units
      for (const u of units) {
        if (u.airlifted) continue;
        radarCtx.fillStyle = u.house === 'Atreides' ? '#60a5fa' : '#f87171';
        radarCtx.beginPath();
        radarCtx.arc(u.x * cellW, u.y * cellH, 2.2, 0, Math.PI * 2);
        radarCtx.fill();
      }

      // Render carryalls
      for (const c of carryalls) {
        radarCtx.fillStyle = c.house === 'Atreides' ? '#93c5fd' : '#fca5a5';
        radarCtx.fillRect(c.x * cellW - 1.5, c.y * cellH - 1.5, 3, 3);
      }

      // Sandworm radar blip
      if (!sandworm.submerged && !sandworm.dormant) {
        const pulse = 0.5 + 0.5 * Math.sin(animTime * 0.01);
        radarCtx.fillStyle = `rgba(245, 158, 11, ${pulse})`;
        radarCtx.beginPath();
        radarCtx.arc(sandworm.x * cellW, sandworm.y * cellH, 3.8, 0, Math.PI * 2);
        radarCtx.fill();
      }

      // Sweeping radar beam
      const sweepAngle = (animTime * 0.002) % (Math.PI * 2);
      radarCtx.save();
      radarCtx.translate(rw / 2, rh / 2);
      radarCtx.rotate(sweepAngle);
      radarCtx.strokeStyle = 'rgba(34, 197, 94, 0.4)';
      radarCtx.lineWidth = 1.5;
      radarCtx.beginPath();
      radarCtx.moveTo(0, 0);
      radarCtx.lineTo(rw, 0);
      radarCtx.stroke();
      radarCtx.restore();
    }

    /* =========================================================================
       MAIN ANIMATION & KINEMATICS LOOP (60 FPS)
       ========================================================================= */
    let lastAnimTime = performance.now();

    function gameLoop(animTime) {
      const dt = Math.min(0.05, (animTime - lastAnimTime) / 1000);
      lastAnimTime = animTime;

      updateKinematics(dt);
      updateParticles();

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          renderTile(x, y, tiles[y][x], animTime);
        }
      }
      for (const b of buildings) renderBuilding(b, animTime);
      for (const u of units) renderUnit(u, animTime);
      for (const c of carryalls) renderCarryall(c, animTime);
      renderSandworm(animTime);
      renderParticles();
      renderMarqueeBox();

      renderRadar(animTime);

      requestAnimationFrame(gameLoop);
    }
    requestAnimationFrame(gameLoop);

    /* =========================================================================
       HARKONNEN GPU LLM OPPONENT & AUTOPLAY INTEGRATION
       ========================================================================= */
    let gpuMode = false, gpuBusy = false;
    const HAR_UNIT_COSTS = { Trike: 150, CombatTank: 300, Harvester: 400 };

    function setOpponentLabel(t) { document.getElementById('hud-opponent').textContent = t; }

    function toggleGpuMode() {
      initAudio();
      playSound('click');
      gpuMode = !gpuMode;
      document.getElementById('btn-gpu').textContent = 'Play against GPU: ' + (gpuMode ? 'ON' : 'OFF');
      setOpponentLabel(gpuMode ? 'GPU LLM (Qwen3.5-4B)' : 'Script AI');
      logMsg(gpuMode ? 'Opponent set to host GPU LLM.' : 'Opponent set to Script AI.', 'sys');
    }

    function compactState() {
      const har = units.filter(u => u.house === 'Harkonnen').map(u => [u.type, Math.round(u.x), Math.round(u.y), u.hp]);
      const atr = units.filter(u => u.house === 'Atreides').map(u => [u.type, Math.round(u.x), Math.round(u.y), u.hp]);
      return { width: W, height: H, tick: tickCount, credits: credits.Harkonnen, units: har, enemy_units: atr };
    }

    function requestGpuMove() {
      if (gpuBusy) return;
      gpuBusy = true;
      setOpponentLabel('GPU thinking...');
      const ctl = new AbortController();
      const to = setTimeout(() => ctl.abort(), 45000);
      fetch('/api/dune3000/gpu-opponent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(compactState()),
        signal: ctl.signal
      })
      .then(r => r.json())
      .then(d => {
        if (d && d.ok && d.command) {
          applyGpuCommand(d.command);
          setOpponentLabel('GPU LLM: ' + d.command.op);
        } else {
          scriptFallbackMove();
          setOpponentLabel('GPU idle, script fallback');
        }
      })
      .catch(() => {
        scriptFallbackMove();
        setOpponentLabel('GPU offline, script fallback');
      })
      .finally(() => {
        clearTimeout(to);
        gpuBusy = false;
      });
    }

    function scriptFallbackMove() {
      if (credits.Harkonnen >= 300) applyGpuCommand({ op: 'TRAIN', unit: 'CombatTank' });
      else applyGpuCommand({ op: 'ATTACK', x: 4.5, y: 4.5 });
    }

    function applyGpuCommand(c) {
      if (c.op === 'TRAIN') {
        const cost = HAR_UNIT_COSTS[c.unit];
        if (!cost || credits.Harkonnen < cost) return;
        credits.Harkonnen -= cost;
        const isTank = c.unit === 'CombatTank';
        units.push({
          type: c.unit, house: 'Harkonnen', x: 20.5, y: 20.5, tx: 5.5, ty: 5.5,
          hp: isTank ? 140 : 90, maxHp: isTank ? 140 : 90,
          spice: 0, maxSpice: c.unit === 'Harvester' ? 700 : 0,
          dmg: isTank ? 25 : (c.unit === 'Trike' ? 15 : 5),
          range: isTank ? 4.0 : 2.8,
          angle: Math.PI,
          turretAngle: Math.PI,
          speed: isTank ? 1.6 : 2.6,
          turnTimer: 0,
          airlifted: false,
          wormPanic: false,
          retreatWarning: false,
          lastAttacker: null
        });
        playSound('build');
        logMsg(`GPU Harkonnen Commander trained ${c.unit}.`, 'combat');
      } else if (c.op === 'BUILD') {
        const spec = BUILDING_SPECS[c.building] || { cost: 200, hp: 400 };
        if (credits.Harkonnen < spec.cost || buildings.some(b => b.x === c.x && b.y === c.y)) return;
        credits.Harkonnen -= spec.cost;
        buildings.push({
          type: c.building, house: 'Harkonnen', x: c.x, y: c.y, hp: spec.hp, maxHp: spec.hp,
          pProd: spec.pProd || 0, pCons: spec.pCons || 0, range: spec.range || 0, dmg: spec.dmg || 0
        });
        playSound('build');
        logMsg(`GPU Harkonnen Commander built ${c.building} at (${c.x}, ${c.y}).`, 'combat');
      } else if (c.op === 'ATTACK') {
        units.filter(u => u.house === 'Harkonnen' && u.type !== 'Harvester' && !u.airlifted).forEach(u => {
          u.tx = (c.x || 4) + 0.5; u.ty = (c.y || 4) + 0.5;
        });
        logMsg(`GPU Harkonnen Commander ordered strike on (${c.x}, ${c.y}).`, 'combat');
      }
    }

    let autoTimer = setInterval(stepTick, 1200);
    function toggleAutoplay() {
      initAudio();
      playSound('click');
      const btn = document.getElementById('btn-autoplay');
      if (autoTimer) {
        clearInterval(autoTimer);
        autoTimer = null;
        btn.textContent = 'Auto-Play: OFF';
      } else {
        autoTimer = setInterval(stepTick, 1200);
        btn.textContent = 'Auto-Play: ON';
      }
    }

    logMsg('Tactical Command Online. Squad marquee select, undulating Shai-Hulud & Dune 2000 structures active.', 'sys');
    updateHud();
  </script>
</body>
</html>